# Shared river storage (Upstash Redis). Leave both empty and the site runs
# on its in-memory fallback instead — fine for a preview, but wishes only
# live as long as that one server instance does.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional admin token for DELETE /api/wishes/[id] (removing a wish from the
# river). When unset, the delete route returns 404.
LOY_ADMIN_TOKEN=
