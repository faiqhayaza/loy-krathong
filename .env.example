# Shared river storage (Cloudflare KV). Leave all three empty and the
# site runs on its in-memory fallback instead — fine for a preview, but
# wishes only live as long as that one server instance does.
# The token needs only Account → Workers KV Storage → Edit on the
# Cloudflare account; the namespace is `loy-krathong-wishes`.
CLOUDFLARE_ACCOUNT_ID=
LOY_KV_NAMESPACE_ID=
LOY_KV_API_TOKEN=

# Optional admin token for DELETE /api/wishes/[id] (removing a wish from the
# river). When unset, the delete route returns 404.
LOY_ADMIN_TOKEN=
